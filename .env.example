# Copiez ce fichier en .env pour le developpement local.
# Sur Render, ces valeurs se renseignent dans Environment > Environment Variables.

# --- Django ---
# Generer avec :
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=remplacez-moi
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# --- Base de donnees ---
# Vide en local (SQLite). Sur Render, fourni automatiquement par le service Postgres.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Frontend autorise (separes par des virgules) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Service partenaire Agharina ---
AGHARINA_API_URL=https://admin-akarina.akarina.shop/api/biens
SERVICE_TAX_RATE=0.02
# Numeros obtenus via : python manage.py creer_comptes_service
AGHARINA_ACCOUNT_NUMBER=
POOLPAY_BANK_ACCOUNT_NUMBER=
